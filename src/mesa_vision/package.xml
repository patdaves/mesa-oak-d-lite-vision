<?xml version="1.0"?>
<package format="3">
  <name>mesa_vision</name>
  <version>0.1.0</version>
  <description>OAK-D Lite person/obstacle detection and obstacle confirmation for the MESA robot.</description>
  <maintainer email="team@example.org">MESA vision team</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>sensor_msgs_py</depend>
  <depend>mesa_vision_msgs</depend>
  <exec_depend>tf2_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
